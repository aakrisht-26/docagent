# core.autocrlf is enabled on Windows checkouts, and without these rules Git
# guesses at content type. It guessed "text" for the e2e PDF fixture, which
# would rewrite line endings inside the binary and corrupt it on clone.
# Mark the binary fixture formats explicitly so they round-trip byte-for-byte.

# packages.txt is piped line-by-line to `apt-get install` by Streamlit
# Community Cloud. A CRLF checkout would make the package name `ffmpeg`,
# which apt cannot find — the same build break as a comment line, arriving by a
# different route. It currently survives only because core.autocrlf normalises
# it; this makes that explicit rather than incidental.
packages.txt text eol=lf

*.pdf   binary
*.xlsx  binary
*.xls   binary
*.wav   binary
*.mp3   binary
*.m4a   binary
*.flac  binary
*.ogg   binary
*.webm  binary

# Vendored fonts for the PDF export. Binary — a line-ending rewrite corrupts a
# TTF exactly as it would a PDF fixture.
*.ttf   binary
