# ============================================================
# DocAgent — environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows cmd)
#     Copy-Item .env.example .env   (PowerShell)
#
# `.env` is gitignored and must never be committed.
# Every value here is optional EXCEPT a Groq API key.
# ============================================================


# ── REQUIRED: Groq API key(s) ─────────────────────────────────────────────
# Get keys from https://console.groq.com/keys
#
# Use GROQ_API_KEYS (plural) for multiple keys. DocAgent rotates through them
# round-robin and fails over automatically on rate limits (HTTP 429) and on
# invalid keys (HTTP 401).
#
# IMPORTANT: if you spread keys across several lines, the value MUST be wrapped
# in double quotes. Without quotes, python-dotenv stops at the first newline and
# silently loads only the first key, and logs
#     "Python-dotenv could not parse statement starting at line N"
#
# Correct multiline form (quoted):
GROQ_API_KEYS="gsk_replace_me_key_one,
gsk_replace_me_key_two,
gsk_replace_me_key_three"

# Single key on one line is also fine, quoted or not:
# GROQ_API_KEYS=gsk_replace_me_key_one

# Legacy single-key variable. Still honoured and merged with the above, so you
# do not need both. Prefer GROQ_API_KEYS.
# GROQ_API_KEY=gsk_replace_me_single_key


# ── OPTIONAL: application settings ────────────────────────────────────────
# Every value below has a working default in configs/default.yaml.
# Uncomment only what you want to override.

# Maximum upload size in MB. Must match the Streamlit uploader limit, which is
# derived from this value at runtime. Default: 50
# DOCAGENT_MAX_FILE_MB=50

# Logging verbosity: DEBUG | INFO | WARNING | ERROR. Default: INFO
# DOCAGENT_LOG_LEVEL=INFO

# Log file path, relative to the repo root. Default: logs/docagent.log
# DOCAGENT_LOG_FILE=logs/docagent.log

# Debug mode. When true, the UI re-raises pipeline exceptions instead of
# catching them and rendering an error message, so Streamlit shows its own
# traceback and debuggers can break on the failure. Default: false
# DOCAGENT_DEBUG=false


# ── OPTIONAL: Groq / LLM settings ─────────────────────────────────────────

# Set to false to disable all LLM calls. Summarisation and question extraction
# then fall back to extractive (non-LLM) modes. Useful offline and in tests.
# Default: true
# DOCAGENT_GROQ_ENABLED=true

# OpenAI-compatible endpoint. Default: https://api.groq.com/openai/v1
# DOCAGENT_GROQ_URL=https://api.groq.com/openai/v1

# Chat model used for classification, summarisation, extraction and chat.
# Default: openai/gpt-oss-120b
# DOCAGENT_GROQ_MODEL=openai/gpt-oss-120b

# Per-request timeout in seconds. Default: 180
# DOCAGENT_GROQ_TIMEOUT=180
